# Copie para .env e preencha com valores reais. Nunca commitar o .env.
#
# Atencao com variaveis opcionais (com valor padrao no codigo): deixar a
# linha presente e em branco (ex.: "CHAVE=") NAO ativa o padrao do Python -
# python-decouple so aplica o default quando a chave esta AUSENTE do arquivo.
# Por isso, para as opcionais, a linha abaixo vem comentada: descomente e
# preencha somente se quiser um valor diferente do padrao.

# ===== Django core =====
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Banco de dados (MySQL) =====
DATABASE_NAME=fsbuilder
DATABASE_USER=fsbuilder
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# ===== Documentos da DF (upload/armazenamento) =====
# Pasta privada fora do MEDIA_ROOT publico. Padrao: <projeto>/private_media
# Em producao, apontar para fora da arvore do projeto, ex.:
# DOCUMENTOS_ROOT=/var/lib/fsbuilder/documentos
# DOCUMENTOS_ROOT=
# Backend de storage. Padrao: local. Trocar para "df.storages.DocumentosS3Storage"
# quando migrar para S3 - nao requer migration, ver df/storages.py.
# DOCUMENTOS_STORAGE_BACKEND=df.storages.DocumentosLocalStorage
# DOCUMENTOS_MAX_UPLOAD_MB=25

# --- AWS S3 (guarda dos documentos na nuvem) ---
# Para ligar: descomente TODAS as linhas abaixo e preencha. Passo a passo no guia
# 'Configurar o AWS S3 para o FSBuilder'. Depois rode: python manage.py verificar_s3
# NUNCA commite o .env com as chaves reais, nem as envie por chat/e-mail.
# DOCUMENTOS_STORAGE_BACKEND=df.storages.DocumentosS3Storage
# AWS_STORAGE_BUCKET_NAME=nome-do-bucket
# AWS_S3_REGION_NAME=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===== E-mail =====
# 'graph' (Microsoft 365 via MSAL OAuth2) ou 'smtp'
EMAIL_SEND_METHOD=smtp
DEFAULT_FROM_EMAIL=noreply@fsbuilder.com

# Microsoft Graph API (obrigatorio apenas se EMAIL_SEND_METHOD=graph)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SMTP (obrigatorio apenas se EMAIL_SEND_METHOD=smtp)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ===== Celery / Redis =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== Convites e notificacoes =====
CONVITE_EXPIRACAO_DIAS=7
CONVITE_MAX_REENVIOS=3
# True em dev para pular o Celery e enviar convites de forma sincrona
CONVITE_ENVIO_SINCRONO=False
DF_NOTIFICACAO_SINCRONO=False

# ===== URLs e links de e-mail =====
BASE_URL=http://localhost:8000

# ===== Reset de senha =====
PASSWORD_RESET_EXPIRACAO_HORAS=24
